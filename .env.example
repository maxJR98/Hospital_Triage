# =====================================================
# Variables de Entorno - Hospital del Norte
# Copiar este archivo como .env y configurar los valores
# =====================================================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambiar-por-clave-secreta-segura-min-32-caracteres

# --- Base de Datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospital_triage
DB_USER=root
DB_PASSWORD=

# --- Correo Electrónico (SMTP) ---
MAIL_SERVER=smtp.hospitalnorte.bo
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=sistema@hospitalnorte.bo
MAIL_PASSWORD=password-correo
MAIL_DEFAULT_SENDER=sistema@hospitalnorte.bo
